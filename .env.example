# OpenCode Zen (cloud) — https://opencode.ai/auth
# Prefer chat/completions models with the OpenAI SDK (e.g. free: big-pickle)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_CHAT_MODEL=big-pickle

# Ollama (local — used when OPENCODE_API_KEY is unset)
# Also used for embeddings in Phase 2 (Zen has no embed models)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
