# Backend selector: "opencode" (default) or "ollama"
# BACKEND=ollama

# OpenCode Zen (cloud) — https://opencode.ai/auth
# Prefer chat/completions models with the OpenAI SDK (e.g. free: big-pickle)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_CHAT_MODEL=big-pickle
OPENCODE_EMBED_MODEL=nomic-embed-text-v1.5

# OpenCode Zen does not support embeddings.
# For Phase 2 ingest/RAG, configure OpenAI embeddings:
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local) — optional overrides (defaults work out-of-the-box)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text
